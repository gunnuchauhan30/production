# Copy this file to .env and fill in real values before running.

# Points at PPE's OWN database — never chanda_store.
PPE_DATABASE_URL=postgresql://ppe_user:ppe_password@localhost:5432/chanda_ppe

# Generate a real random secret for production, e.g.: openssl rand -hex 32
PPE_JWT_SECRET=change-this-in-production
